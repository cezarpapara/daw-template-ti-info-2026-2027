<?php

namespace App\Controller;

use OpenApi\Attributes as OA;
use Symfony\Bundle\FrameworkBundle\Controller\AbstractController;
use Symfony\Component\HttpFoundation\JsonResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Attribute\Route;

// Exercițiu pentru laborator, disponibil numai în mediile dev și test.
#[OA\Tag(name: 'Laboratorul 10')]
final class PasswordDemoController extends AbstractController
{
    #[Route('/api/demo/parola', name: 'api_password_demo', methods: ['POST'], env: ['dev', 'test'])]
    #[OA\RequestBody(required: true, content: new OA\JsonContent(example: ['password' => 'parola123']))]
    #[OA\Response(response: 200, description: 'Hash aleatoriu și rezultatele verificării; parola nu este salvată')]
    #[OA\Response(response: 400, description: 'JSON invalid sau parolă de demonstrație invalidă')]
    public function hash(Request $request): JsonResponse
    {
        try {
            $data = json_decode($request->getContent(), false, 512, JSON_THROW_ON_ERROR);
        } catch (\JsonException) {
            return $this->json(['errors' => ['body' => 'Corpul cererii trebuie să fie un obiect JSON valid.']], 400);
        }
        if (!$data instanceof \stdClass) {
            return $this->json(['errors' => ['body' => 'Corpul cererii trebuie să fie un obiect JSON valid.']], 400);
        }

        $password = $data->password ?? null;
        if (!is_string($password) || $password === '' || strlen($password) > 72 || str_contains($password, "\0")) {
            return $this->json(['errors' => ['password' => 'Folosiți o parolă demonstrativă de 1–72 octeți, fără caractere nule.']], 400);
        }

        $hash = password_hash($password, PASSWORD_DEFAULT);
        $wrongPassword = $password === 'parola-gresita' ? 'alta-parola' : 'parola-gresita';

        return $this->json([
            'hash' => $hash,
            'parolaCorecta' => password_verify($password, $hash),
            'parolaGresita' => password_verify($wrongPassword, $hash),
        ], 200, ['Cache-Control' => 'no-store']);
    }
}
