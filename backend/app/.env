# ==========================================================================
#  Variabilele de mediu ale aplicatiei Symfony (configurarea pentru DEV)
# ==========================================================================
#
#  .env        -> valorile implicite. Este urcat pe GitHub, deci NU puneti aici
#                 parole sau chei reale.
#  .env.local  -> valorile voastre personale, doar pe calculatorul vostru
#                 (suprascriu ce este in .env). Este in .gitignore, deci NU
#                 ajunge pe GitHub. Creati-l doar daca aveti nevoie.
#
#  Documentatie: https://symfony.com/doc/current/configuration.html#configuring-environment-variables-in-env-files

###> symfony/framework-bundle ###
# dev = modul de dezvoltare (erori detaliate, fara cache agresiv)
APP_ENV=dev
APP_SECRET=daw_secret_doar_pentru_dezvoltare_2026
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Conexiunea la baza de date PostgreSQL.
# Format: postgresql://UTILIZATOR:PAROLA@SERVER:PORT/NUME_BAZA
# "daw-postgres" este numele containerului de baza de date (vezi backend/compose.yaml).
DATABASE_URL="postgresql://daw:daw@daw-postgres:5432/daw?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# Ce adrese au voie sa apeleze API-ul din browser (aici: orice port de pe localhost,
# deci si frontend-ul React de pe http://localhost:5173)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
