{
  "info": {
    "name": "PW / DAW API (TI + Informatica, 2026-2027)",
    "description": "Cereri de exemplu pentru backend-ul Symfony. Porniti backend-ul inainte (docker compose up -d in folderul backend). Operatiile care modifica date necesita autentificare: rulati intai Autentificare > Login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Stare backend",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Verifica daca backend-ul si baza de date functioneaza."
      }
    },
    {
      "name": "Autentificare",
      "item": [
        {
          "name": "Cont nou",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creeaza un cont cu rolul ROLE_USER. Parola: minim 8 caractere si suficient de complexa. Max 5 conturi noi pe ora de pe acelasi IP.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@exemplu.ro\",\n  \"password\": \"Parola-Sigura-2026!\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Pune token-ul JWT in cookie-ul BEARER (httpOnly). Postman pastreaza cookie-ul si il trimite automat la cererile urmatoare. Dupa 5 incercari gresite in 15 minute raspunsul este 429.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@exemplu.ro\",\n  \"password\": \"Parola-Sigura-2026!\"\n}"
            }
          }
        },
        {
          "name": "Utilizatorul curent",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Necesita autentificare (cookie-ul BEARER sau headerul Authorization: Bearer <token>)."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Sterge cookie-ul BEARER."
          }
        }
      ]
    },
